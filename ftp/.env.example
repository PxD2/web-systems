# HOLD gateway (SFTP-first). Never commit real values.
HOLD_HOST=hold.example.com
HOLD_PORT=22
HOLD_USER=hold_lab
HOLD_ROOT=public
HOLD_SLUG=lab
# Path to private key for local publish (Actions uses secret HOLD_KEY instead)
HOLD_KEY_PATH=~/.ssh/hold_lab_ed25519

# Legacy outbound FTP (Pipe B client hosts) — optional; not HOLD product
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/public_html
